{
  "version": 2,
  "source_repository": "kevstermcgee/BlueEngine",
  "target_repository": "kevstermcgee/BlueEngineGames",
  "preserve": [
    "games/bluedm",
    "games/riftwake",
    "games/skyhook-sprint",
    "games/magnet-mine",
    "games/wrecking-orbit",
    "games/pulse-nova",
    "games/spooky-kart",
    "games/physics-lab",
    "games/clockwork-pinball",
    "games/wobble-tower",
    "games/tumble-maze",
    "games/laser-vault",
    "games/floor-is-lava",
    "games/echo-chambers",
    "games/relic-relay",
    "games/prism-matrix",
    "games/phantom-maze",
    "games/bomb-defusal",
    "games/turret-trench",
    "games/weight-balance",
    "games/target-gallery",
    "games/dead-air"
  ],
  "collections": {
    "games": [
      {
        "source": "assets/games",
        "destination": "."
      },
      {
        "source": "games/signal-garden/src",
        "destination": "signal-garden/src"
      },
      {
        "source": "games/signal-garden/tests",
        "destination": "signal-garden/tests"
      },
      {
        "source": "games/signal-garden/assets",
        "destination": "signal-garden/assets"
      },
      {
        "source": "games/signal-garden/scripts",
        "destination": "signal-garden/scripts"
      },
      {
        "source": "games/signal-garden/Cargo.toml",
        "destination": "signal-garden/Cargo.toml"
      },
      {
        "source": "games/signal-garden/Cargo.lock",
        "destination": "signal-garden/Cargo.lock"
      },
      {
        "source": "games/signal-garden/build.rs",
        "destination": "signal-garden/build.rs"
      },
      {
        "source": "games/signal-garden/AGENTS.md",
        "destination": "signal-garden/AGENTS.md"
      },
      {
        "source": "games/signal-garden/CLAUDE.md",
        "destination": "signal-garden/CLAUDE.md"
      },
      {
        "source": "games/signal-garden/README.md",
        "destination": "signal-garden/README.md"
      },
      {
        "source": "games/signal-garden/STATUS.md",
        "destination": "signal-garden/STATUS.md"
      },
      {
        "source": "games/signal-garden/rustfmt.toml",
        "destination": "signal-garden/rustfmt.toml"
      },
      {
        "source": "games/signal-garden/.gitignore",
        "destination": "signal-garden/.gitignore"
      }
    ],
    "prototypes": [
      {
        "source": "examples/prototype.rs",
        "destination": "rust-api"
      },
      {
        "source": "templates/multiplayer-game",
        "destination": "multiplayer-game"
      }
    ],
    "tests": [
      {
        "source": "assets/maps/starters",
        "destination": "starter-maps"
      },
      {
        "source": "examples/network_smoke.rs",
        "destination": "network"
      },
      {
        "source": "examples/validate_expanded_maps.rs",
        "destination": "validation"
      }
    ],
    "demos": [
      {
        "source": "examples",
        "destination": "examples"
      },
      {
        "source": "previews",
        "destination": "previews"
      }
    ]
  },
  "playables": [
    {
      "slug": "three-switches",
      "name": "Three Switches",
      "entry": "games/three-switches/game.json",
      "files": [
        "games/three-switches"
      ],
      "arguments": [
        "--game",
        "content/games/three-switches/game.json"
      ]
    },
    {
      "slug": "first-light",
      "name": "First Light",
      "entry": "demos/examples/first-light.json",
      "files": [
        "demos/examples/first-light.json",
        "demos/examples/first-light.wav"
      ],
      "arguments": [
        "--map",
        "content/demos/examples/first-light.json"
      ]
    }
  ]
}
