{
  "schema_version": 1,
  "name": "Observatory Night Watch",
  "map": "edited-map.json",
  "player_profile": {
    "height": 1.8,
    "crouched_height": 1.1,
    "radius": 0.23,
    "eye_height": 1.68,
    "walk_speed": 3.2,
    "sprint_speed": 5.6,
    "crouch_speed": 1.3,
    "jump_height": 0.35
  },
  "spawn_points": [
    {
      "id": "watchkeeper",
      "feet": [
        -4.0,
        0.0,
        0.0
      ],
      "yaw": 1.5707964
    }
  ],
  "counters": {
    "battery": 20,
    "calibration": 0,
    "shutter_cycles": 0
  },
  "interactables": [
    {
      "entity": "shutter-switch",
      "enabled": true,
      "visible": true
    },
    {
      "entity": "calibrator",
      "enabled": false,
      "visible": true
    },
    {
      "entity": "uplink",
      "enabled": false,
      "visible": true
    }
  ],
  "trigger_zones": [],
  "movers": [
    {
      "id": "shutter-motion",
      "entity": "shutter",
      "translation": [
        0,
        3,
        0
      ],
      "duration_ticks": 90,
      "initial_open": false
    }
  ],
  "timers": [
    {
      "id": "battery-clock",
      "duration_ticks": 60,
      "auto_start": true,
      "repeats": true
    }
  ],
  "rules": [
    {
      "id": "open-shutter",
      "on_interact": "shutter-switch",
      "once": true,
      "condition": {
        "counter": "shutter_cycles",
        "equals": 0
      },
      "actions": [
        {
          "action": "set_enabled",
          "entity": "calibrator",
          "enabled": true
        },
        {
          "action": "set_enabled",
          "entity": "shutter-switch",
          "enabled": false
        },
        {
          "action": "increment",
          "counter": "shutter_cycles",
          "amount": 1
        }
      ]
    },
    {
      "id": "calibrate",
      "on_interact": "calibrator",
      "once": false,
      "condition": {
        "counter": "calibration",
        "less_than": 3
      },
      "actions": [
        {
          "action": "increment",
          "counter": "calibration",
          "amount": 1
        }
      ]
    },
    {
      "id": "unlock-uplink",
      "condition": {
        "counter": "calibration",
        "at_least": 3
      },
      "once": true,
      "actions": [
        {
          "action": "set_enabled",
          "entity": "uplink",
          "enabled": true
        },
        {
          "action": "set_enabled",
          "entity": "calibrator",
          "enabled": false
        }
      ]
    },
    {
      "id": "transmit",
      "on_interact": "uplink",
      "once": true,
      "actions": [
        {
          "action": "complete"
        }
      ]
    },
    {
      "id": "drain",
      "on_timer": "battery-clock",
      "once": false,
      "condition": {
        "counter": "battery",
        "greater_than": 0
      },
      "actions": [
        {
          "action": "increment",
          "counter": "battery",
          "amount": -1
        }
      ]
    },
    {
      "id": "blackout",
      "on_timer": "battery-clock",
      "once": true,
      "condition": {
        "counter": "battery",
        "equals": 0
      },
      "actions": [
        {
          "action": "fail"
        }
      ]
    }
  ],
  "presentation": {
    "objective": "Open shutter, calibrate three times, then transmit",
    "success": "Observation transmitted. Night watch complete! E / R to play again",
    "failure": "Battery depleted. E / R to restart the night watch",
    "counters": {
      "battery": {
        "label": "Battery",
        "format": "clock"
      },
      "calibration": {
        "label": "Calibration",
        "units": "/ 3"
      },
      "shutter_cycles": {
        "visible": false
      }
    },
    "palette": {
      "background": [
        0.04,
        0.07,
        0.14,
        1
      ],
      "panel": [
        0.03,
        0.06,
        0.12,
        0.92
      ],
      "text": [
        0.85,
        0.92,
        1,
        1
      ],
      "accent": [
        1,
        0.74,
        0.3,
        1
      ],
      "success": [
        0.35,
        1,
        0.75,
        1
      ],
      "failure": [
        1,
        0.45,
        0.35,
        1
      ]
    },
    "hud": {
      "scale": 1,
      "margin": 16,
      "width": 880,
      "crosshair": true
    }
  }
}
