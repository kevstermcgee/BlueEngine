{
  "version": 1,
  "contract": {
    "scope": "Static map authoring using the packaged native engine; no engine source access required.",
    "units": "metres; Y up; linear RGB 0..1; box sizes are half extents; prop origins are at the bottom",
    "map_schema_version": 1,
    "map_document": "schema_version, name, scene, colliders, entities; use new to obtain a native-valid house template",
    "validation_authority": "Native audit/apply and describe. Capability metadata is curated and checked in CI; not complete Rust reflection.",
    "output_policy": "New output paths only; native apply validates the entire batch before saving.",
    "activation": "Launch bin/BE2.exe --map MAP.json or bin/be2-headless.exe --map MAP.json --ticks 600. Exporting does not change the default map.",
    "supported": [
      "static unparented box/sphere/cylinder/cone geometry",
      "colliders",
      "inspect entities",
      "native prop placement",
      "transactional translate/remove patches"
    ],
    "unsupported": [
      "new gameplay rules",
      "Prop Hunt rounds/disguises",
      "custom scripts",
      "animated maps",
      "imported meshes in maps",
      "custom spawn in map v1",
      "rotating/scaling prefab instances",
      "authoring network transport configuration through map v1"
    ],
    "context_policy": "Use describe, query, schema, assets, recipes, select, near and verify. Do not read src/ for content authoring. Unsupported behavior requires a separate engine change."
  },
  "commands": {
    "describe": "Live native capabilities, units, limits, version and provenance",
    "query TEXT --limit N": "Bounded local search of assets, recipes and capability topics (default 5, maximum 20)",
    "schema patch": "Strict machine-readable patch schema",
    "assets": "Available stable asset IDs and native kinds",
    "recipes": "Known reusable patches, dependencies and verification guidance",
    "new OUT.json": "Export the native house as a new editable map",
    "add MAP TEMPLATE OUT --id ID --at X,Y,Z": "Instantiate an asset or recipe with namespaced IDs using a native transaction",
    "map OP ...": "audit, diff, select, near, ray, route, floorplan, export-scene or apply",
    "verify MAP NEW_DIR [--route ROUTE] [--capture] [--baseline REPORT]": "Persistent audit/route results and optional house camera captures with exact baseline comparison"
  },
