  "topics": [
    {
      "id": "movement",
      "summary": "Shared native 60 Hz controller. Validate stairs, doors and garden reachability with routes. Routes are straight waypoint legs, not pathfinding.",
      "tools": [
        "map route",
        "verify --route"
      ],
      "dependencies": [
        "colliders",
        "spawn clearance"
      ],
      "examples": [
        "tools/examples/upstairs.route.json",
        "tools/examples/garden.route.json"
      ]
    },
    {
      "id": "ownership",
      "summary": "Use select with an instance ID to retrieve slash-prefixed visual, collision and entity components. Translate/remove all relevant component IDs together. Built-in house components do not necessarily share IDs.",
      "tools": [
        "map select",
        "map near",
        "map apply",
        "map diff"
      ],
      "dependencies": [
        "stable IDs",
        "patch schema"
      ]
    },
    {
      "id": "visual_regression",
      "summary": "Twelve house cameras include the menu. Captures require a graphical desktop. Hash comparison flags changes for review; it does not assess aesthetics. Camera tour is house-specific.",
      "tools": [
        "verify --capture",
        "verify --capture --baseline"
      ],
      "dependencies": [
        "packaged client",
        "graphical desktop"
      ]
    },
    {
      "id": "map_contract",
      "summary": "Use the native house export as the canonical map example. Static primitives, fixed positive transforms, inspect-only actions. Strict native validation is the authority.",
      "tools": [
        "new",
        "schema patch",
        "map audit"
      ],
      "dependencies": [
        "schema_version 1",
        "packaged be2-tools"
      ]
    },
    {
      "id": "multiplayer",
      "summary": "Headless simulation exists. Network transport, authoritative Prop Hunt rules and disguise selection are not implemented; content tools cannot add them.",
      "tools": [],
      "dependencies": [
        "engine development required"
      ]
    },
    {
      "id": "asset_catalogue",
      "summary": "Seventeen reusable native props including art, plants, ceramics, lighting, books, candles, a clock and basket. Use assets for IDs and dimensions. Lamps and candles are static, unlit decor; clock hands are fixed.",
      "tools": [
        "assets",
        "add",
        "query"
      ],
      "dependencies": [
        "native catalog"
      ]
    },
    {
      "id": "interior_prefabs",
      "summary": "23 additional static interior templates: desks, lockers, backpack, computer, paperwork, mugs, cabinets, appliances, stock, written blackboards and closed doors. Separate from native add_prop kinds. Discover with python tools/place_interior.py --list.",
      "tools": [
        "tools/place_interior.py --list",
        "tools/place_interior.py MAP ASSET OUTPUT --id ID --at X,Y,Z --yaw 90"
      ],
      "dependencies": [
        "assets/props/interiors/catalog.json",
        "packaged native audit"
      ]
    },
    {
      "id": "native-engine-discovery",
      "tags": [
        "multiplayer",
        "physics",
        "builder",
        "prelude",
        "Test Lab",
        "engine"
      ],
      "summary": "Native be2-tools describe lists commands and limits; search TEXT returns feature files/checks. export-lab OUT.json starts in Blue Test Lab. docs/AI_QUICKSTART.md is the compact Rust prototype API. Multiplayer exists, but map v1 does not define game rules or spawn profiles."
    }
  ]
}
