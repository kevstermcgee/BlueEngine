{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"BE2 edit transaction v1",
 "type":"array","maxItems":1000,
 "$defs":{
  "vector":{"type":"array","items":{"type":"number","minimum":-1000,"maximum":1000},"minItems":3,"maxItems":3},
  "id":{"type":"string","pattern":"^[A-Za-z0-9_/-]+$","minLength":1,"maxLength":100},
  "ids":{"type":"array","items":{"$ref":"#/$defs/id"}}
 },
 "items":{"oneOf":[
  {"type":"object","additionalProperties":false,"required":["op","id","label","center","half_extents","color"],"properties":{"op":{"const":"add_box"},"id":{"$ref":"#/$defs/id"},"label":{"type":"string","maxLength":100},"center":{"$ref":"#/$defs/vector"},"half_extents":{"type":"array","items":{"type":"number","exclusiveMinimum":0,"maximum":1000},"minItems":3,"maxItems":3},"color":{"type":"array","items":{"type":"number","minimum":0,"maximum":1},"minItems":3,"maxItems":3},"structural":{"type":"boolean","default":false}}},
  {"type":"object","additionalProperties":false,"required":["op","id","label","kind","origin"],"properties":{"op":{"const":"add_prop"},"id":{"$ref":"#/$defs/id"},"label":{"type":"string","maxLength":100},"kind":{"enum":["apple","cereal","chair","table","framed-art","framed-botanical","sculpture","vase-plant","bowl","table-lamp","book-stack","candle-trio","potted-cactus","flower-vase","tall-vase","mantel-clock","woven-basket"]},"origin":{"$ref":"#/$defs/vector"}}},
  {"type":"object","additionalProperties":false,"required":["op","nodes","colliders","entities","delta"],"properties":{"op":{"const":"translate"},"nodes":{"$ref":"#/$defs/ids"},"colliders":{"$ref":"#/$defs/ids"},"entities":{"$ref":"#/$defs/ids"},"delta":{"$ref":"#/$defs/vector"}}},
  {"type":"object","additionalProperties":false,"required":["op","nodes","colliders","entities"],"properties":{"op":{"const":"remove"},"nodes":{"$ref":"#/$defs/ids"},"colliders":{"$ref":"#/$defs/ids"},"entities":{"$ref":"#/$defs/ids"}}}
 ]}
}
