    "condition": {
      "additionalProperties": false,
      "description": "A rule guard over counters. Exactly one form is used per node:\na leaf (`counter` plus one or more comparisons, all of which must hold), or a compound\n(`all`, `any`, `not`). `{\"counter\": \"x\", \"equals\": 1}` is the original form and still works.",
      "oneOf": [
        {
          "anyOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "not_equals"
              ]
            },
            {
              "required": [
                "less_than"
              ]
            },
            {
              "required": [
                "greater_than"
              ]
            },
            {
              "required": [
                "at_most"
              ]
            },
            {
              "required": [
                "at_least"
              ]
            }
          ],
          "required": [
            "counter"
          ]
        },
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        },
        {
          "required": [
            "not"
          ]
        }
      ],
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/condition"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/condition"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "at_least": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        },
        "at_most": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        },
        "counter": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_/-]+$",
          "type": "string"
        },
        "equals": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        },
        "greater_than": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        },
        "less_than": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        },
        "modulo": {
          "description": "Compare `counter mod modulo` (always 0..modulo) instead of the raw value.",
          "format": "int32",
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "not_equals": {
          "format": "int32",
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "integer"
        }
      },
      "type": "object"
    }
