{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "map",
    "player_profile",
    "spawn_points",
    "counters",
    "interactables",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "map": {
      "type": "string",
      "minLength": 1
    },
    "player_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "crouched_height",
        "radius",
        "eye_height",
        "walk_speed",
        "sprint_speed",
        "crouch_speed",
        "jump_height"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        },
        "crouched_height": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        },
        "radius": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "eye_height": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3
        },
        "walk_speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "sprint_speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "crouch_speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "jump_height": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "spawn_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feet",
          "yaw"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "feet": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw": {
            "type": "number"
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "counters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_/-]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "interactables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "enabled"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "visible": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "trigger_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bounds",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "max": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "movers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity",
          "translation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "translation": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "minItems": 3,
            "maxItems": 3
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "initial_open": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "timers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_ticks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36000
          },
          "auto_start": {
            "type": "boolean"
          },
          "repeats": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "once",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_/-]+$"
          },
          "on_interact": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_/-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "on_enter": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_/-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "on_exit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_/-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "on_timer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_/-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "anyOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "type": "null"
              }
            ]
          },
          "once": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "counter",
                    "amount"
                  ],
                  "properties": {
                    "action": {
                      "const": "increment"
                    },
                    "counter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "entity",
                    "visible"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_visible"
                    },
                    "entity": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "counter",
                    "value"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_counter"
                    },
                    "counter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "entity",
                    "enabled"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_enabled"
                    },
                    "entity": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "mover",
                    "open"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_mover"
                    },
                    "mover": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    },
                    "open": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "timer"
                  ],
                  "properties": {
                    "action": {
                      "const": "start_timer"
                    },
                    "timer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "timer"
                  ],
                  "properties": {
                    "action": {
                      "const": "stop_timer"
                    },
                    "timer": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_/-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "complete"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "fail"
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 4
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    },
    "presentation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[ -~]+$"
        },
        "success": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[ -~]+$"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[ -~]+$"
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[ -~]+$"
              },
              "units": {
                "type": "string",
                "maxLength": 12,
                "pattern": "^[ -~]*$"
              },
              "format": {
                "enum": [
                  "number",
                  "clock"
                ]
              }
            }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "panel": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "text": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "accent": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "success": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "failure": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "hud": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1.5
            },
            "margin": {
              "type": "number",
              "minimum": 8,
              "maximum": 48
            },
            "width": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 240,
              "maximum": 900
            },
            "crosshair": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueEngine GameDocument v1",
  "$comment": "Native game-validate also checks references, UTF-8 byte limits, profile relationships, spawn clearance, static box bounds and confined map paths.",
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one form: a leaf (counter plus at least one comparison, all must hold) or one of all / any / not. Nest at most 4 deep, 16 parts in total.",
      "properties": {
        "counter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_/-]+$"
        },
        "modulo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "compare counter mod modulo"
        },
        "equals": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "not_equals": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "less_than": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "greater_than": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "at_most": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "at_least": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "oneOf": [
        {
          "required": [
            "counter"
          ],
          "anyOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "not_equals"
              ]
            },
            {
              "required": [
                "less_than"
              ]
            },
            {
              "required": [
                "greater_than"
              ]
            },
            {
              "required": [
                "at_most"
              ]
            },
            {
              "required": [
                "at_least"
              ]
            }
          ]
        },
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        },
        {
          "required": [
            "not"
          ]
        }
      ]
    }
  }
}
