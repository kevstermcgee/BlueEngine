{"id": "h-checkpoint-save", "prompt": "autosave game progress when the player reaches a checkpoint", "expect_features": ["save_state"], "expect_paths": ["docs/SAVE_STATE.md"], "notes": "Held-out: written after the index fixes and not used to tune them."}
{"id": "h-bot-takeover", "prompt": "fill empty seats with bots when players leave an online match", "expect_features": ["netplay"], "expect_paths": ["docs/NETPLAY.md"], "notes": "NetGame bot takeover."}
{"id": "h-kerb-flicker", "prompt": "my road kerbs flicker when the camera moves", "expect_features": ["geometry_kit"], "expect_paths": ["src/viewer/kit/lint.rs"], "notes": "Coplanar z-fighting."}
{"id": "h-menu-nav", "prompt": "navigate menus with the gamepad d-pad and keyboard arrows", "expect_features": ["custom_simulation"], "expect_paths": ["src/viewer/devkit/menu.rs"], "notes": "MenuNav/MenuStep, ADR 0021."}
{"id": "h-trigger-zone", "prompt": "add a trigger zone that opens a door when the player walks in", "expect_features": ["game_documents"], "expect_paths": ["src/viewer/game.rs"], "notes": "GameDocument trigger_zones and movers."}
{"id": "h-prop-throw", "prompt": "let the player pick up and throw props", "expect_features": ["prop_physics"], "expect_paths": ["src/viewer/prop_physics.rs"], "notes": "PropPhysics::throw_for_player."}
{"id": "h-invisible-mesh", "prompt": "my big mesh is invisible, I think it is over the vertex limit", "expect_features": ["rendering_traps"], "expect_paths": ["src/viewer/kit/batch.rs"], "notes": "Template::split / Batch::add."}
{"id": "h-hosting", "prompt": "run the dedicated game server on a small PC as a service", "expect_features": ["multiplayer"], "expect_paths": ["docs/HOSTING.md"], "notes": "HOSTING.md, be2-ctl (ADR 0031)."}
{"id": "h-windows-compile", "prompt": "check that Windows-only code compiles from this Linux machine", "expect_features": ["change_workflow"], "expect_paths": ["docs/CHANGE_WORKFLOW.md"], "notes": "check --windows."}
{"id": "h-scenario-test", "prompt": "drive a game.json with scripted inputs and assert the final state", "expect_features": ["simulation_scenarios"], "expect_paths": ["docs/BEHAVIORAL_TESTING.md"], "notes": "Scenario files and game-scenario."}
{"id": "h-find-prop", "prompt": "find a prop or prefab for my map by name", "expect_features": ["asset_library"], "expect_paths": ["tools/assets.py"], "notes": "assets.py search."}
{"id": "h-vertex-capacity", "prompt": "window config for a game that draws a very large mesh", "expect_features": ["game_presentation"], "expect_paths": ["src/viewer/game_client.rs"], "notes": "window_config."}
